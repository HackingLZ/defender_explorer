# ===========================================
# Defender Explorer Configuration
# ===========================================
# Copy this file to .env and fill in the values
# WARNING: Never commit .env to version control

# ===========================================
# Required Settings
# ===========================================

# PostgreSQL password - CHANGE THIS
POSTGRES_PASSWORD=your_secure_password_here

# API key for admin write operations - generate with: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here

# ===========================================
# Optional Settings
# ===========================================

# Database URL (automatically constructed from POSTGRES_PASSWORD in docker-compose)
# Only set this if running outside Docker or using a different database
# DATABASE_URL=postgresql+asyncpg://defender:your_password@localhost:5432/defender_explorer

# Path to VDM files (default: ./data/vdm)
VDM_PATH=./data/vdm

# Path to extracted data (default: ./data/extracted)
EXTRACTED_PATH=./data/extracted

# CORS origins (comma-separated, only needed for separate frontend)
# CORS_ORIGINS=http://localhost:3000

# Exact reverse-proxy addresses allowed to supply X-Real-IP (empty trusts none).
# The reverse proxy must replace, not preserve, incoming X-Real-IP headers.
# TRUSTED_PROXY_IPS=172.18.0.1
